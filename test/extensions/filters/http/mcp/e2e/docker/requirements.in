# The Python dependencies of the mcp-client and mcp-server images: the MCP Python SDK version that
# the suite is pinned to (run.sh's MCP_SDK_VERSION). requirements.txt, with every transitive
# dependency pinned by hash, is generated from this file, in this directory, with Python 3.13:
#
#   pip-compile --generate-hashes --allow-unsafe --strip-extras --output-file=requirements.txt \
#     requirements.in
mcp==2.2.0
